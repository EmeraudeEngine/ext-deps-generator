diff --git a/onnxruntime_mlas.cmake b/onnxruntime_mlas.cmake
index 46f9ca2c38..fefda8910d 100644
--- a/onnxruntime_mlas.cmake
+++ b/onnxruntime_mlas.cmake
@@ -858,11 +858,57 @@ else()
           ${MLAS_SRC_DIR}/qkv_quant_common.h
           ${MLAS_SRC_DIR}/qkv_quant_kernel_avx2.cpp
         )
+        # cvtfp16Avx.S is written with the AVX-NE-CONVERT encodings
+        # (vcvtneeph2ps / vcvtneoph2ps). The guard below tests the *compiler*
+        # version, but turning those mnemonics into bytes is the *assembler*'s
+        # job, and GNU as only learned them in binutils 2.40. A recent GCC
+        # driving an older gas -- gcc-13/14 on Ubuntu 22.04, which is stuck on
+        # binutils 2.38 -- therefore dies with "no such instruction". Ask the
+        # assembler itself rather than trusting the compiler version.
         if(CMAKE_CXX_COMPILER_VERSION GREATER_EQUAL 13.1 AND NOT(APPLE))
-          set(mlas_platform_srcs_avx2
-            ${mlas_platform_srcs_avx2}
-            ${MLAS_SRC_DIR}/x86_64/cvtfp16Avx.S
+          include(CheckCXXSourceCompiles)
+          set(OLD_CMAKE_REQUIRED_FLAGS_NECONVERT "${CMAKE_REQUIRED_FLAGS}")
+          set(CMAKE_REQUIRED_FLAGS "${OLD_CMAKE_REQUIRED_FLAGS_NECONVERT} -mavx2 -mf16c")
+          check_cxx_source_compiles("
+            int main() {
+              __asm__ __volatile__(\"vcvtneeph2ps (%rdi), %ymm0\");
+              return 0;
+            }"
+            MLAS_ASSEMBLER_SUPPORTS_AVX_NE_CONVERT
           )
+          set(CMAKE_REQUIRED_FLAGS "${OLD_CMAKE_REQUIRED_FLAGS_NECONVERT}")
+          unset(OLD_CMAKE_REQUIRED_FLAGS_NECONVERT)
+
+          if(MLAS_ASSEMBLER_SUPPORTS_AVX_NE_CONVERT)
+            set(mlas_platform_srcs_avx2
+              ${mlas_platform_srcs_avx2}
+              ${MLAS_SRC_DIR}/x86_64/cvtfp16Avx.S
+            )
+          else()
+            # Dropping the kernel is not enough: platform.cpp still references
+            # MlasCastF16ToF32KernelAvx (its #if only tests __GNUC__ / _MSC_VER),
+            # so the link would fail on an undefined symbol. Define it as a thin
+            # forward to the AVX2 kernel -- every CPU that advertises
+            # AVX_NE_CONVERT also has F16C, so the dispatch stays correct and
+            # only loses the faster conversion path.
+            message(STATUS "MLAS: assembler cannot encode AVX-NE-CONVERT (binutils < 2.40); "
+                           "leaving cvtfp16Avx.S out and routing "
+                           "MlasCastF16ToF32KernelAvx to the AVX2 kernel")
+            set(mlas_cast_f16_fallback "${CMAKE_CURRENT_BINARY_DIR}/mlas_cast_f16_avx_fallback.cpp")
+            file(WRITE "${mlas_cast_f16_fallback}"
+"// Generated by the ext-deps-generator onnxruntime patch -- do not edit.\n"
+"// Stands in for x86_64/cvtfp16Avx.S when the assembler predates binutils 2.40.\n"
+"#include \"mlasi.h\"\n"
+"\n"
+"void\n"
+"MLASCALL\n"
+"MlasCastF16ToF32KernelAvx(const unsigned short* Source, float* Destination, size_t Count)\n"
+"{\n"
+"    MlasCastF16ToF32KernelAvx2(Source, Destination, Count);\n"
+"}\n"
+            )
+            target_sources(onnxruntime_mlas PRIVATE "${mlas_cast_f16_fallback}")
+          endif()
         endif()
 
         include(CheckCXXSourceCompiles)
