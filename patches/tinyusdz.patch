diff --git a/CMakeLists.txt b/CMakeLists.txt
index bf1c28660..56d78ad8f 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -4435,3 +4435,56 @@ if(WIN32)
                                            "${CMAKE_CURRENT_SOURCE_DIR}")
   endif()
 endif()
+
+#
+# ---- Installation rules (added by the ext-deps-generator patch system) ----
+#
+# Upstream only installs the optional C API shared library. This build disables the C API, so a
+# stock configure/build/install cycle produces libtinyusdz_static.a and exports NOTHING — the
+# install step reports success while writing no library, no header and no package config.
+#
+# The block below installs the static library, the public header tree and a CMake package
+# config, so consumers can `find_package(tinyusdz CONFIG)` like every other ext-deps library.
+#
+include(GNUInstallDirs)
+
+# The headers include one another by relative path ("core/prim.hh", "nonstd/expected.hpp"),
+# so the source tree layout MUST be preserved on install and BOTH the root and external/
+# directories must land on the consumer's include path.
+target_include_directories(${TINYUSDZ_TARGET_STATIC}
+  PUBLIC
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/src>
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/src/external>
+    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/tinyusdz>
+    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/tinyusdz/external>
+)
+
+install(TARGETS ${TINYUSDZ_TARGET_STATIC}
+  EXPORT tinyusdzTargets
+  ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
+  LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+)
+
+# `attic` holds superseded code kept for reference; it is not part of the public surface.
+install(DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}/src/
+  DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/tinyusdz
+  FILES_MATCHING
+    PATTERN "*.hh"
+    PATTERN "*.h"
+    PATTERN "*.hpp"
+    PATTERN "*.inc"
+    PATTERN "attic" EXCLUDE
+)
+
+install(EXPORT tinyusdzTargets
+  FILE tinyusdzTargets.cmake
+  NAMESPACE tinyusdz::
+  DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/tinyusdz
+)
+
+file(WRITE ${CMAKE_CURRENT_BINARY_DIR}/tinyusdzConfig.cmake
+"include(\"\${CMAKE_CURRENT_LIST_DIR}/tinyusdzTargets.cmake\")\n")
+
+install(FILES ${CMAKE_CURRENT_BINARY_DIR}/tinyusdzConfig.cmake
+  DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/tinyusdz
+)
diff --git a/src/nonstd/expected.hpp b/src/nonstd/expected.hpp
index 5b19bf0d7..603e6c543 100644
--- a/src/nonstd/expected.hpp
+++ b/src/nonstd/expected.hpp
@@ -255,6 +255,22 @@ namespace nonstd {
 
 #if nsel_CONFIG_NO_EXCEPTIONS
 # if nsel_CONFIG_NO_EXCEPTIONS_SEH
+// ---- ext-deps-generator patch ----
+// <windows.h> defines the min/max macros unless NOMINMAX is set first, and they shred
+// every `std::numeric_limits<T>::max()` the compiler meets afterwards. This header is
+// reached on MSVC as soon as exceptions are off: value-types.hh only tests __EXCEPTIONS
+// and __cpp_exceptions (GNU/Clang macros), so under /EHs-c- it force-defines
+// nsel_CONFIG_NO_EXCEPTIONS=1, and the SEH default above is (that && _MSC_VER).
+// Guarding here rather than on the compiler command line also covers consumers of the
+// installed headers, who reach this same include from their own -fno-exceptions TUs.
+// src/external/tinyexr.h guards its own <windows.h> exactly this way.
+#  ifndef WIN32_LEAN_AND_MEAN
+#   define WIN32_LEAN_AND_MEAN
+#  endif
+#  ifndef NOMINMAX
+#   define NOMINMAX
+#  endif
+// ---- end of patch ----
 #  include <windows.h>   // for ExceptionCodes
 # else
 // already included: <cassert>
