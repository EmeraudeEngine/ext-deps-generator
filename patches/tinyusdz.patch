   RECONSTRUCT_PRIM(GeomBasisCurves)
   RECONSTRUCT_PRIM(GeomCamera)
   RECONSTRUCT_PRIM(GeomSubset)
+  // ---- ext-deps-generator patch ----
+  // GeomPointInstancer was missing from this table although
+  // ReconstructPrim<GeomPointInstancer> is fully implemented in prim-reconstruct.cc.
+  // A PrimSpec this function cannot reconstruct returns nullopt, and the caller
+  // (ReconstructPrimFromPrimSpecRec) then drops the prim WITH ITS ENTIRE SUBTREE — the
+  // only trace being a warning most callers never print. Measured on Intel's Jungle
+  // Ruins: every PointInstancer read correctly from the crate file, present in the
+  // Layer with its positions/orientations/scales/protoIndices, and absent from the
+  // Stage. The whole vegetation of the scene silently disappeared here.
+  // ---- end of patch ----
+  RECONSTRUCT_PRIM(GeomPointInstancer)
+  // The same omission, with the same consequence, for the UsdLux types upstream
+  // implements but never listed here. Untested for lack of an asset using them;
+  // their ABSENCE is what is known to be harmful.
+  RECONSTRUCT_PRIM(DomeLight_1)
+  RECONSTRUCT_PRIM(GeometryLight)
+  RECONSTRUCT_PRIM(PortalLight)
+  RECONSTRUCT_PRIM(LightFilter)
+  RECONSTRUCT_PRIM(PluginLightFilter)
   RECONSTRUCT_PRIM(SphereLight)
   RECONSTRUCT_PRIM(DomeLight)
   RECONSTRUCT_PRIM(CylinderLight)
diff --git a/src/composition.cc b/src/composition.cc
index 8ba93d0a0..45b87b57d 100644
--- a/src/composition.cc
+++ b/src/composition.cc
@@ -230,6 +230,37 @@ bool LoadAsset(AssetResolutionResolver &resolver,
   }
 
   // TODO: Use std::stack to manage AssetResolutionResolver state?
+  //
+  // ---- ext-deps-generator patch ----
+  // The resolver below is mutated and, upstream, never restored. `CompositeSublayersRec()`
+  // resolves each subLayer of a layer in a loop, and every iteration calls in here; once the
+  // recursion has descended into one subLayer, the resolver still points at THAT child's
+  // directory, so every following sibling is resolved from the wrong place.
+  //
+  // Concretely, on a root layer whose first subLayer is `./cameras/defaultCam.usda`, the next
+  // sibling `./elements/Anthurium/PI_Anthurium.usd` is looked up in `<root>/cameras` and the
+  // whole composition fails. Saving and restoring the state around the mutation is the "stack"
+  // the TODO above asks for, in its minimal form.
+  struct ResolverStateGuard {
+    AssetResolutionResolver &resolver_ref;
+    std::string saved_cwp;
+    std::vector<std::string> saved_search_paths;
+
+    explicit ResolverStateGuard(AssetResolutionResolver &r)
+        : resolver_ref(r),
+          saved_cwp(r.current_working_path()),
+          saved_search_paths(r.search_paths()) {}
+
+    ~ResolverStateGuard() {
+      resolver_ref.set_current_working_path(saved_cwp);
+      resolver_ref.set_search_paths(saved_search_paths);
+    }
+
+    ResolverStateGuard(const ResolverStateGuard &) = delete;
+    ResolverStateGuard &operator=(const ResolverStateGuard &) = delete;
+  } resolver_state_guard(resolver);
+  // ---- end of patch ----
+
   if (current_working_path.size()) {
     resolver.set_current_working_path(current_working_path);
   }
