@@ -1123,12 +1123,23 @@ bool RenderSceneConverter::ConvertVolume(
 
     // Decode the .vdb into dense float grids.
     std::vector<usdVol::VDBGrid> grids;
+    // ---- ext-deps-generator patch ----
+    // usdVol.cc (and the vendored tinyvdb it wraps) is only compiled with LIGHTUSD_WITH_USDVOL,
+    // but this call was not guarded: turning the option off left an undefined reference to
+    // usdVol::ReadVDBFromMemory() in the archive, so the first consumer link failed. Without the
+    // module a volume field is skipped, exactly like one whose .vdb cannot be decoded.
+#if defined(LIGHTUSD_USE_USDVOL)
     std::string vwarn, verr;
     if (!usdVol::ReadVDBFromMemory(asset.data(), asset.size(), resolvedPath,
                                    &grids, &vwarn, &verr)) {
       DCOUT("Failed to decode vdb: " << resolvedPath << " : " << verr);
       continue;
     }
+#else
+    DCOUT("vdb decoding not built (LIGHTUSD_WITH_USDVOL=OFF): " << resolvedPath);
+    continue;
+#endif
+    // ---- end of patch ----
     if (grids.empty()) continue;
 
     // Pick the grid whose name matches the requested field, else the first.
