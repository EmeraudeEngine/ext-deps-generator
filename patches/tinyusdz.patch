diff --git a/CMakeLists.txt b/CMakeLists.txt
index 1001412d5..05162c99c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -438,7 +438,14 @@ endif()
 
 if (PROJECT_IS_TOP_LEVEL)
   message(STATUS "LightUSD is being built as toplevel project so set CXX standard here.")
-  if(LIGHTUSD_WITH_COROUTINE)
+  # ---- ext-deps-generator patch ----
+  # The unguarded set() below shadowed a -DCMAKE_CXX_STANDARD given on the command line, so the
+  # library compiled at C++17 whatever the consumer asked for, without a warning. A standard that
+  # is already set now wins; with none, upstream's choice below applies unchanged.
+  if(CMAKE_CXX_STANDARD)
+    message(STATUS "Use C++${CMAKE_CXX_STANDARD} (CMAKE_CXX_STANDARD given by the caller).")
+  # ---- end of patch ----
+  elseif(LIGHTUSD_WITH_COROUTINE)
     message(STATUS "Use C++20 for c++20 coroutine.")
     # Coroutine support requires C++20
     set(CMAKE_CXX_STANDARD 20)
@@ -4459,3 +4466,64 @@ if(WIN32)
                                            "${CMAKE_CURRENT_SOURCE_DIR}")
   endif()
 endif()
+
+#
+# ---- Installation rules (added by the ext-deps-generator patch system) ----
+#
+# Upstream only installs the optional C API shared library and the Python module. This build
+# disables both, so a stock configure/build/install cycle produces liblightusd_static.a and
+# exports NOTHING — the install step reports success while writing no library, no header and
+# no package config.
+#
+# The block below installs the static library, the public header tree and a CMake package
+# config, so consumers can `find_package(lightusd CONFIG)` and link `lightusd::lightusd_static`
+# (the same name as upstream's own in-tree ALIAS).
+#
+include(GNUInstallDirs)
+
+# The headers include one another by relative path ("core/prim.hh", "nonstd/expected.hpp"),
+# so the source tree layout MUST be preserved on install and BOTH the root and external/
+# directories must land on the consumer's include path.
+target_include_directories(${LIGHTUSD_TARGET_STATIC}
+  PUBLIC
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/src>
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/src/external>
+    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/lightusd>
+    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/lightusd/external>
+)
+
+install(TARGETS ${LIGHTUSD_TARGET_STATIC}
+  EXPORT lightusdTargets
+  ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
+  LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+)
+
+# Not installed: `attic` (superseded code kept for reference) and the Python binding trees
+# (`blender` vendors a whole CPython 3.9 include directory, `python`, pybind11, nanobind) —
+# none of them is reachable from the C++ API this build exposes.
+install(DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}/src/
+  DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/lightusd
+  FILES_MATCHING
+    PATTERN "*.hh"
+    PATTERN "*.h"
+    PATTERN "*.hpp"
+    PATTERN "*.inc"
+    PATTERN "attic" EXCLUDE
+    PATTERN "blender" EXCLUDE
+    PATTERN "python" EXCLUDE
+    PATTERN "pybind11" EXCLUDE
+    PATTERN "nanobind" EXCLUDE
+)
+
+install(EXPORT lightusdTargets
+  FILE lightusdTargets.cmake
+  NAMESPACE lightusd::
+  DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/lightusd
+)
+
+file(WRITE ${CMAKE_CURRENT_BINARY_DIR}/lightusdConfig.cmake
+"include(\"\${CMAKE_CURRENT_LIST_DIR}/lightusdTargets.cmake\")\n")
+
+install(FILES ${CMAKE_CURRENT_BINARY_DIR}/lightusdConfig.cmake
+  DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/lightusd
+)
diff --git a/src/composition.cc b/src/composition.cc
index 043903a4b..a9b21619a 100644
--- a/src/composition.cc
+++ b/src/composition.cc
@@ -4060,12 +4060,36 @@ void RemapPathsInPrimSpecTree(PrimSpec &ps, const NamespaceMapping &mapping) {
             p = mapping.Apply(p);
           }
         }
-      } else if (prop.second.is_attribute_connection()) {
+      // ---- ext-deps-generator patch ----
+      // Every attribute that HAS connections, not only those that are connection-ONLY.
+      //
+      // `Property::is_attribute_connection()` forwards to `Attribute::is_connection()`, which
+      // returns false as soon as the attribute also carries a value (attribute.hh) — so an input
+      // authored as BOTH a fallback value and a connection was skipped here and kept pointing into
+      // the sub-tree's PRE-SPLICE path. Authoring both is the normal UsdPreviewSurface idiom, and
+      // the one Omniverse Kit emits:
+      //
+      //   color3f inputs:diffuseColor = (0.18, 0.18, 0.18)
+      //   color3f inputs:diffuseColor.connect = </World/Looks/Slate/UsdUVTexture.outputs:rgb>
+      //
+      // The failure is invisible at composition time: the connection dangles, and Tydra later
+      // rejects the material with "Cannot find path </World/Looks/Slate> in the Stage", falling
+      // back to the value sitting right next to it — a flat 0.18 grey that reads as "the asset has
+      // no textures" while all of them are there. Measured on WorldLobby.usdz (an Omniverse Kit
+      // export).
+      //
+      // ⚠️ This repository carried the same fix for v0.9.4, in `ReplaceRootPrimPathRec()`. That
+      // function is `[[maybe_unused]]` dead code since the v1.0.0 composition rework and the live
+      // rewrite below inherited the original predicate — still so at v1.0.0-rc4. Only the live site
+      // is patched here; the dead one is deliberately left alone.
+      } else if (prop.second.is_attribute() &&
+                 prop.second.attribute().has_connections()) {
         Attribute &attr = prop.second.attribute();
         for (auto &conn : attr.connections()) {
           conn = mapping.Apply(conn);
         }
       }
+      // ---- end of patch ----
     }
 
     // Remap composition arc target paths
