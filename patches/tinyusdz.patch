+// ---- ext-deps-generator patch ----
+// Validates an asset path for COMPOSITION, where a relative path is resolved against the
+// directory of the layer that declared it and `..` is therefore legal USD:
+//   - must not be empty
+//   - must not start with '/' or a Windows drive (e.g. "C:")
+//   - interior '..' segments are collapsed lexically
+//   - LEADING '..' segments are PRESERVED, for the resolver to join with the layer's directory
+//
+// `ValidateAndNormalizeAssetPath()` above rejects '..' outright, which is the right rule for a
+// CONTAINMENT check (`IsSafeUSDZAssetPath()`, which decides what may be read out of a zip) and
+// the wrong one for composition: a Kit-exported stage writes its own subLayers as
+// "../Source/Lobby/assets_Lobby.usd" and its assets as "../../Assets/Vegetation/*.usd". Rejected
+// here, those layers never reach resolution and the stage composes to its cameras alone.
+//
+// Containment stays enforced where it belongs — at resolution. The USDZ handler only ever returns
+// keys present in the archive table, and the filesystem path goes through the engine's own
+// weakly_canonical + exists check. Neither can be escaped by a leading '..'.
+inline bool ValidateAndNormalizeRelativeAssetPath(const std::string &path,
+                                                  std::string *out) {
+  if (!out) {
+    return false;
+  }
+  if (path.empty()) {
+    return false;
+  }
+
+  std::string p = path;
+  std::replace(p.begin(), p.end(), '\\', '/');
+
+  if (!p.empty() && p[0] == '/') {
+    return false;
+  }
+
+  if (p.size() >= 2 &&
+      ((p[0] >= 'A' && p[0] <= 'Z') || (p[0] >= 'a' && p[0] <= 'z')) &&
+      p[1] == ':') {
+    return false;
+  }
+
+  std::stringstream ss(p);
+  std::string part;
+  std::vector<std::string> parts;
+  size_t leading_parents = 0;
+  while (std::getline(ss, part, '/')) {
+    if (part.empty() || part == ".") {
+      continue;
+    }
+    if (part == "..") {
+      // Collapse against the last named segment when there is one, otherwise this is a leading
+      // '..' and it must survive for the resolver to join it with the layer's directory.
+      if (parts.empty()) {
+        leading_parents++;
+      } else {
+        parts.pop_back();
+      }
+      continue;
+    }
+    parts.push_back(std::move(part));
+  }
+
+  if (parts.empty() && leading_parents == 0) {
+    return false;
+  }
+
+  std::string result;
+  for (size_t i = 0; i < leading_parents; i++) {
+    if (i > 0) {
+      result.push_back('/');
+    }
+    result += "..";
+  }
+  for (size_t i = 0; i < parts.size(); i++) {
+    if (!result.empty()) {
+      result.push_back('/');
+    }
+    result += parts[i];
+  }
+
+  *out = std::move(result);
+  return true;
+}
+// ---- end of patch ----
+
