# target-commit: 6df3ec34557879fff673706f4a1d9fbd0f3a6f0e

diff --git a/build/make/Makefile b/build/make/Makefile
index 39dff825b..a2a121572 100644
--- a/build/make/Makefile
+++ b/build/make/Makefile
@@ -305,14 +305,22 @@ $(DIST_DIR)/$(1): $(2)
 	$(qexec)cp -p $$< $$@
 endef
 
+# On macOS, use libtool -static instead of ar for creating static archives.
+# macOS ar creates fat Mach-O archives from cross-arch objects that it then
+# cannot update, breaking cross-compilation (e.g., ARM host -> x86_64 target).
+ifeq ($(shell uname -s),Darwin)
+define archive_template
+$(1):
+	$(if $(quiet),@echo "    [AR] $$@")
+	$(qexec)/usr/bin/libtool -static -o $$@ $$^
+endef
+else
 define archive_template
-# Not using a pattern rule here because we don't want to generate empty
-# archives when they are listed as a dependency in files not responsible
-# for creating them.
 $(1):
 	$(if $(quiet),@echo "    [AR] $$@")
 	$(qexec)$$(AR) $$(ARFLAGS) $$@ $$^
 endef
+endif
 
 # Don't use -Wl,-z,defs with Clang's sanitizers.
 #
diff --git a/build/make/gen_msvs_vcxproj.sh b/build/make/gen_msvs_vcxproj.sh
index 1e1db05bb..23783f9ec 100755
--- a/build/make/gen_msvs_vcxproj.sh
+++ b/build/make/gen_msvs_vcxproj.sh
@@ -366,9 +366,10 @@ generate_vcxproj() {
                 fi
             fi
             tag_content CharacterSet Unicode
-            if [ "$config" = "Release" ]; then
-                tag_content WholeProgramOptimization true
-            fi
+            # WholeProgramOptimization (/GL) deliberately NOT emitted: LTCG
+            # objects hide their DEFAULTLIB directives from dumpbin (breaking
+            # CRT validation) and tie the static lib to the exact MSVC toolset
+            # that produced it — unacceptable for a redistributable archive.
             close_tag PropertyGroup
         done
     done
